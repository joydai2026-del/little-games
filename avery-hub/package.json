{
  "name": "avery-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:brand": "bash ../scripts/check-brand.sh",
    "migrate:staging": "wrangler d1 migrations apply avery_hub_staging --env staging --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "cf:dev": "wrangler dev --env staging"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.128.0",
    "@cloudflare/workers-types": "^5.20260907.1"
  }
}
