{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/worker/**/*.ts",
    "src/shared/**/*.ts",
    "tests/bots.test.ts",
    "tests/room-do.test.ts",
    "tests/ai-try.test.ts",
    "tests/worker-index.test.ts",
    "tests/openai.test.ts"
  ]
}
