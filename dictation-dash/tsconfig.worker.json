{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/worker/**/*.ts", "src/shared/**/*.ts", "tests/room-do.test.ts", "tests/agent-flow.test.ts", "tests/harness.ts", "tests/strokes.test.ts", "tests/tts.test.ts", "tests/raw.d.ts"]
}
