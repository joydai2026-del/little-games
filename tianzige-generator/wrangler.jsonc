{
  // JSONC config, tracked in git (the repo .gitignore ignores wrangler.toml only).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tianzige-generator",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // POST /api/sheet fetches up to LIMITS.maxChars stroke files per call, so it
  // gets a per-IP cap. Policy, not source: raise `limit` if a school on one
  // network hits it. `period` may only be 10 or 60.
  "ratelimits": [
    { "name": "SHEET_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Browser and edge cache for one character's stroke file. The data is
    // pinned (hanzi-writer-data@2.0.1, see src/worker/stroke-manifest.json), so
    // a week is safe.
    "STROKES_CACHE_SECONDS": "604800",
    // Largest upstream stroke file accepted. The biggest real one is 8,621 bytes.
    "STROKES_MAX_BYTES": "65536",
    // A "no data for this character" answer can be cached this long.
    "NEGATIVE_CACHE_SECONDS": "86400",
    // POST /api/sheet body cap. 4,000 pasted characters as JSON escapes fit well under it.
    "SHEET_MAX_BODY_BYTES": "32768",
    // Retry-After on a 429. Keep equal to the SHEET_LIMITER period above.
    "SHEET_RETRY_AFTER_SECONDS": "60"
  }
}
